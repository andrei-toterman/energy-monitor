project=energy-monitor
export APSYSTEMS_APP_ID="$(secret-tool lookup project ${project} apsystems app-id)"
export APSYSTEMS_APP_SECRET="$(secret-tool lookup project ${project} apsystems app-secret)"
export APSYSTEMS_ECU_ID="$(secret-tool lookup project ${project} apsystems ecu-id)"
export APSYSTEMS_SID="$(secret-tool lookup project ${project} apsystems sid)"
export HOMEWIZARD_API_PATH="$(secret-tool lookup project ${project} homewizard api-path)"
export HOMEWIZARD_AUTH_TOKEN="$(secret-tool lookup project ${project} homewizard auth-token)"
export HOMEWIZARD_HOST="$(secret-tool lookup project ${project} homewizard host)"
export INFLUXDB_BUCKET="$(secret-tool lookup project ${project} influxdb bucket)"
export INFLUXDB_HOST="$(secret-tool lookup project ${project} influxdb host)"
export INFLUXDB_ORG="$(secret-tool lookup project ${project} influxdb org)"
export INFLUXDB_TOKEN="$(secret-tool lookup project ${project} influxdb token)"
export WIFI_PASSWORD="$(secret-tool lookup project ${project} wifi password)"
export WIFI_SSID="$(secret-tool lookup project ${project} wifi ssid)"
